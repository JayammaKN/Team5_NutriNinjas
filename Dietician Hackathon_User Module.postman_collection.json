              "\r",
              "pm.test(\"Response has required error properties\", function () {\r",
              "\tconst responseJson = pm.response.json();\r",
              "\r",
              "\tpm.expect(responseJson).to.have.property(\"timestamp\");\r",
              "\tpm.expect(responseJson).to.have.property(\"status\");\r",
              "\tpm.expect(responseJson).to.have.property(\"error\");\r",
              "\tpm.expect(responseJson).to.have.property(\"message\");\r",
              "\r",
              "\tpm.expect(responseJson.timestamp).to.be.a(\"string\");\r",
              "\tpm.expect(responseJson.status).to.be.a(\"number\");\r",
              "\tpm.expect(responseJson.error).to.be.a(\"string\");\r",
              "\tpm.expect(responseJson.message).to.be.a(\"string\");\r",
              "\r",
              "\tpm.expect(responseJson.status).to.equal(400);\r",
              "\tpm.expect(responseJson.error).to.equal(\"Bad Request\");\r",
              "});"
            ],
