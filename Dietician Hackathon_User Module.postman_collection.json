  "item": [
    {
      "name": "Login_Happypath",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Login Response has required properties\", function () {\r",
              "    const responseJson = pm.response.json();\r",
              "    \r",
              "\tpm.expect(responseJson).to.have.property('token');\r",
              "    pm.expect(responseJson).to.have.property('type');\r",
              "    pm.expect(responseJson).to.have.property('userId');\r",
              "    pm.expect(responseJson).to.have.property('loginUserEmail');\r",
              "    pm.expect(responseJson).to.have.property('roles');\r",
              "\t\r",
              "\tpm.expect(responseJson.token).to.be.a('string');\r",
              "\tpm.expect(responseJson.type).to.be.a('string');\r",
              "\tpm.expect(responseJson.userId).to.be.a('number');\r",
              "\tpm.expect(responseJson.roles).to.be.an('array');\r",
              "\tpm.expect(responseJson.loginUserEmail).to.be.a('string');\r",
              "\r",
              "});\r",
              "// Save JWT token to environment\r",
              "if (pm.response.code === 200) {\r",
              "    var jsonData = pm.response.json();\r",
              "    if (jsonData.token) {\r",
              "        pm.environment.set(\"token\", jsonData.token);\r",
              "        //pm.collectionVariables.set(\"token\", jsonData.token);\r",
              "        console.log(\"Token saved: \" + jsonData.token);\r",
              "    }\r",
              "}\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n\t\"password\":\"{{password}}\",\r\n\t\"userLoginEmail\":\"{{username}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/login",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
